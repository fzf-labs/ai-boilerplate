          "title": "普通会员权益值"
        },
        "vip": {
          "$ref": "#/definitions/app.v1.MembershipBenefitValue",
          "title": "VIP会员权益值"
        },
        "svip": {
          "$ref": "#/definitions/app.v1.MembershipBenefitValue",
