          "title": "权益描述"
        },
        "benefitValue": {
          "type": "string",
          "title": "权益值"
        },
        "benefitNum": {
          "type": "string",
          "title": "权益次数"
        },
        "sort": {
          "type": "integer",
          "format": "int32",
