        },
        "membershipName": {
          "type": "string",
          "title": "会员类型名称"
        },
        "membershipDescription": {
          "type": "string",
          "title": "会员类型描述"
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "title": "会员状态(-1禁用,1正常)"
        },
        "expiredAt": {
          "type": "string",
