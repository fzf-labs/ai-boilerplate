{
  "swagger": "2.0",
  "info": {
    "title": "app/v1/membership.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "Membership"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/app/v1/membership/benefits": {
      "get": {
        "summary": "获取会员权益列表",
        "operationId": "Membership_GetMembershipBenefits",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/app.v1.GetMembershipBenefitsReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "membershipType",
            "description": "会员类型编码(可选,不传则返回当前用户会员等级的权益)",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "Authorization",
            "description": "Bearer Token",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Membership"
        ]
      }
    },
    "/app/v1/membership/benefits/compare": {
      "get": {
        "summary": "获取会员权益对比（一次返回所有会员类型的权益）",
        "operationId": "Membership_GetMembershipBenefitsCompare",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/app.v1.GetMembershipBenefitsCompareReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "tags": [
          "Membership"
        ]
      }
    },
    "/app/v1/membership/info": {
      "get": {
        "summary": "获取用户会员基础信息",
        "operationId": "Membership_GetUserMembershipInfo",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/app.v1.GetUserMembershipInfoReply"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "Authorization",
            "description": "Bearer Token",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Membership"
        ]
      }
    }
  },
  "definitions": {
    "app.v1.GetMembershipBenefitsCompareReply": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/app.v1.MembershipBenefitCompareItem"
          },
          "title": "权益对比列表"
        }
      },
      "title": "响应-获取会员权益对比"
    },
    "app.v1.GetMembershipBenefitsReply": {
      "type": "object",
